<?xml version="1.0" encoding="utf-8"?>
<!--
  Circular "Emergency SOS" home screen widget background.
  Updated to match home.page.html's exact SOS button radial gradient:
  radial-gradient(circle at 35% 30%, #ff5252 0%, #e53935 50%, #b71c1c 100%)
  Angle 315 gives the matching 45°-step top-left to bottom-right flow.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FF5252"
        android:centerColor="#E53935"
        android:endColor="#B71C1C" />
</shape>
