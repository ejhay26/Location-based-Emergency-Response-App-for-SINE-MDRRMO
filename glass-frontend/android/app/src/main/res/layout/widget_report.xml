<?xml version="1.0" encoding="utf-8"?>
<!--
  Circular "Emergency SOS" home screen widget layout — designed to match
  home.page.html's SOS button (small uppercase "EMERGENCY" caption above
  a large bold "SOS"). Now sized at 2x2 cells so the oval background
  renders as a proper large circle. No icons since we don't have icon
  images. The whole root is the tap target; the click PendingIntent is
  attached to @+id/widget_report_root by ReportWidgetProvider.
  contentDescription on the root describes the combined label for
  accessibility.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_report_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_report_bg"
    android:contentDescription="@string/widget_report_full_label">

    <TextView
        android:id="@+id/widget_report_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_report_caption"
        android:textColor="#DEFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:letterSpacing="0.12"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_report_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_report_label"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:importantForAccessibility="no" />

</LinearLayout>
