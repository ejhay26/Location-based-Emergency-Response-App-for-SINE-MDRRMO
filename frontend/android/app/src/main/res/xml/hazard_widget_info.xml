<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 3a: AppWidgetProviderInfo for the circular "Report Hazard" home
  screen widget. Mirrors report_widget_info.xml — square 1x1 cell
  (minWidth == minHeight) so the oval background in widget_hazard_bg.xml
  renders as a true circle, static launcher shortcut
  (updatePeriodMillis="0"), only reacts to user taps.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="72dp"
    android:minHeight="72dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_hazard"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/widget_hazard" />
