<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for the circular "Emergency SOS" home screen
  widget. Square 2x2 cell (minWidth == minHeight) so the oval background
  in widget_report_bg.xml renders as a true circle at a comfortable size.
  Resizable horizontally and vertically — the oval background
  automatically preserves its circular look when the widget is kept square
  by the user.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="146dp"
    android:minHeight="146dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_report"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/widget_report" />
