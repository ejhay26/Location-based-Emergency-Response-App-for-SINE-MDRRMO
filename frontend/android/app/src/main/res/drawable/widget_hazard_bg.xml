<?xml version="1.0" encoding="utf-8"?>
<!--
  Report Hazard widget background — a rounded rectangle matching
  home.page.html's hazard button (border-radius:20px, gold gradient).
  Changed from oval to rectangle so the widget renders as a proper
  rectangular card rather than an ugly stretched ellipse.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#B8860B"
        android:endColor="#FFC409" />
</shape>
