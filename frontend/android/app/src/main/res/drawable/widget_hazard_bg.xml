<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 3a: circular gold gradient background for the Report Hazard widget,
  matching home.page.html's actual Report Hazard button gradient
  (linear-gradient(135deg,#b8860b,#ffc409)) for visual consistency with the
  in-app button — previously this widget used an unrelated orange (#EF6C00).
  android:angle="135" is an exact RemoteViews-supported match for the CSS
  135deg. Drawn as an oval sized to the widget's square bounds (see
  hazard_widget_info.xml's minWidth==minHeight) so it renders as a true
  circle, not an ellipse.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#B8860B"
        android:endColor="#FFC409" />
</shape>
