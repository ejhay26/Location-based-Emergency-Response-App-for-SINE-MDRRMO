{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDRRMO EMERGENCY RESPONSE APP",
  "version": "0.79.0",
  "identifier": "ph.gov.sine.mdrrmo.emergencyresponse",
  "build": {
    "frontendDist": "../www",
    "devUrl": "http://localhost:8100",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MDRRMO EMERGENCY RESPONSE APP",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 650,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  }
}
