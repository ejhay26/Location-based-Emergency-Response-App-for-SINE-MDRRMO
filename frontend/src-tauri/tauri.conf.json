{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDRRMO EMERGENCY RESPONSE APP",
  "version": "0.72.0",
  "identifier": "ph.gov.sine.mdrrmo.emergencyresponse",
  "build": {
    "frontendDist": "../www",
    "devUrl": "http://localhost:8100",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MDRRMO EMERGENCY RESPONSE APP",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: osmtile: https://server.arcgisonline.com https://*.tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
