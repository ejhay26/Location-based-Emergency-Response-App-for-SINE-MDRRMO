{
  "name": "mdrrmo-emergency-response-app",
  "main": "main.js",
  "version": "0.73.0",
  "author": {
    "name": "MDRRMO-SINE",
    "email": "ejcp2005@gmail.com"
  },
  "homepage": "https://ionicframework.com/",
  "build": {
    "appId": "ph.gov.sine.mdrrmo.emergencyresponse",
    "productName": "MDRRMO EMERGENCY RESPONSE APP",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/assets/icon/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "src/assets/icon/icon.png",
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src/assets/icon/icon.png"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 8100",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "start:desktop": "electron .",
    "build:linux": "ionic build --prod && electron-builder --linux",
    "build:mac": "ionic build --prod && electron-builder --mac",
    "build:win": "ionic build --prod && electron-builder --win",
    "build:mobile": "ionic build --prod && npx cap sync",
    "build:android": "ionic build --prod && npx cap sync android",
    "build:ios": "ionic build --prod && npx cap sync ios",
    "tauri": "tauri",
    "start:desktop:tauri": "tauri dev",
    "build:tauri:win": "tauri build --no-bundle"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/status-bar": "8.0.2",
    "@capawesome/capacitor-android-sms-retriever": "^0.1.1",
    "@ionic/angular": "^8.0.0",
    "@tauri-apps/api": "^2",
    "@lucide/angular": "^1.34.0",
    "chart.js": "^4.5.1",
    "ionicons": "^7.0.0",
    "laravel-echo": "^2.4.0",
    "leaflet": "^1.9.4",
    "lucide-angular": "^1.0.0",
    "motion": "^13.0.0",
    "ngx-image-cropper": "^9.1.6",
    "pusher-js": "^8.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/language-service": "^20.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.3.1",
    "@ionic/angular-toolkit": "^12.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@tauri-apps/cli": "^2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.0"
  },
  "description": "An Ionic project"
}