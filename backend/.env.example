APP_NAME="SINE-MDRRMO"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emergencydb
DB_USERNAME=root
DB_PASSWORD=

# Redis (Optional in Go — in-memory sync engine used by default)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (Resend API)
RESEND_API_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="MDRRMO SAN ISIDRO NUEVA ECIJA EMERGENCY RESPONSE APP"

# PhilSMS Transactional Gateway
PHILSMS_API_TOKEN=
PHILSMS_SENDER_NAME="PhilSMS"

# Firebase Cloud Messaging v1
FIREBASE_PROJECT_ID=mdrrmo-sine-response-app
FIREBASE_CREDENTIALS=storage/app/mdrrmo-sine-response-app-firebase-adminsdk-fbsvc-73bd4e4846.json

# Real-time WebSocket (Pusher/Reverb compatible)
REVERB_APP_ID=sine
REVERB_APP_KEY=6bc0e7b80b37c8d8d8f8
REVERB_APP_SECRET=sine_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=3000

# Disaster Recovery Automated Backups
BACKUP_AUTO_ENABLED=true
BACKUP_INTERVAL_HOURS=2
BACKUP_MAX_INTRADAY=12
BACKUP_MAX_DAILY=7

# Filesystem & Storage
FILESYSTEM_DISK=public
# Optional isolated storage directory (defaults to storage/app/public relative to binary)
STORAGE_PATH=

# Developer Support
DEV_SUPPORT_EMAIL=ejcp2005@gmail.com

# CORS Configuration
CORS_ALLOW_ORIGINS=*
